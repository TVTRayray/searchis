  1851	    #[test]
  1852	    fn group_delete_with_symlink_entry_on_exdev_is_rejected_and_fully_rolled_back() {
  1853	        let env = env();
  1854	        let parent = env.group("父", None);
  1855	        let child = env.group("子", Some(&parent.id));
  1856	        let file = env
  1857	            .import(&[env.source("a.md", b"a")], Some(&child.id))
  1858	            .created
  1859	            .remove(0);
  1860	        let outside = tempfile::tempdir().unwrap();
  1861	        let secret = outside.path().join("secret.txt");
  1862	        fs::write(&secret, "EXTERNAL_SENTINEL").unwrap();
  1863	        // 在 .md 之前排序的链接条目，确保普通文件之前/之后都被覆盖。
  1864	        std::os::unix::fs::symlink(&secret, env.root.join("父/子/z-link.md")).unwrap();
  1865	        std::os::unix::fs::symlink(&secret, env.root.join("父/子/0-link.md")).unwrap();
  1866	        let row_before = env.row(&file.id).rel_path;
  1867	
  1868	        super::fsops::FORCE_EXDEV.with(|f| f.set(true));
  1869	        let result = env.service.group_delete(GroupDeleteInput {
  1870	            id: child.id.clone(),
  1871	            revision: child.revision,
  1872	        });
  1873	        super::fsops::FORCE_EXDEV.with(|f| f.set(false));
  1874	
  1875	        assert_fs_rejected(result);
  1876	        // 完全回滚：目录、链接（仍是链接）、文件、数据库行均原样。
  1877	        for name in ["z-link.md", "0-link.md"] {
  1878	            let meta = fs::symlink_metadata(env.root.join("父/子").join(name)).unwrap();
  1879	            assert!(meta.file_type().is_symlink());
  1880	            assert!(fs::symlink_metadata(env.root.join("父").join(name)).is_err());
  1881	        }
  1882	        assert!(env.on_disk("父/子/a.md"));
  1883	        assert!(!env.on_disk("父/a.md"));
  1884	        assert_eq!(env.row(&file.id).rel_path, row_before);
  1885	        assert!(env
  1886	            .service
  1887	            .repository
  1888	            .group_list()
  1889	            .unwrap()
  1890	            .iter()
  1891	            .any(|g| g.id == child.id));
  1892	        // 根外文件内容未出现在模板目录中，且目标未被改动。
  1893	        let mut stack = vec![env.root.clone()];
  1894	        while let Some(dir) = stack.pop() {
  1895	            for entry in fs::read_dir(&dir).unwrap().flatten() {
  1896	                let meta = fs::symlink_metadata(entry.path()).unwrap();
  1897	                if meta.is_dir() {
  1898	                    stack.push(entry.path());
  1899	                } else if meta.is_file() {
  1900	                    assert_ne!(fs::read(entry.path()).unwrap(), b"EXTERNAL_SENTINEL");
  1901	                }
  1902	            }
  1903	        }
  1904	        assert_eq!(fs::read_to_string(&secret).unwrap(), "EXTERNAL_SENTINEL");
  1905	    }
