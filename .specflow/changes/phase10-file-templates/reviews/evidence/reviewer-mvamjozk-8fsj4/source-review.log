   153	pub fn move_file(src: &Path, dst: &Path) -> Result<(), AppError> {
   154	    if dst.symlink_metadata().is_ok() {
   155	        return Err(fs_error("目标位置已存在同名文件。"));
   156	    }
   157	    if let Some(parent) = dst.parent() {
   158	        ensure_dir(parent)?;
   159	    }
   160	    // 移动前先识别条目类型：符号链接只允许同设备 rename（移动链接本身）。
   161	    let src_is_symlink = fs::symlink_metadata(src)
   162	        .map_err(|_| fs_error("无法移动模板文件。"))?
   163	        .file_type()
   164	        .is_symlink();
   165	    match rename_for_move(src, dst) {
   166	        Ok(()) => Ok(()),
   167	        Err(error) if error.raw_os_error() == Some(libc::EXDEV) => {
   168	            if src_is_symlink {
   169	                return Err(fs_error("无法跨设备移动符号链接。"));
   170	            }
   171	            copy_verify_remove(src, dst)
   172	        }
   173	        Err(_) => Err(fs_error("无法移动模板文件。")),
   174	    }
   175	}
