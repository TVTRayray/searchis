HEADING / MOTION / FOCUS DECLARATIONS
@import "tailwindcss";

/* Bundled latin subsets (OFL, @fontsource). CJK falls back to system Noto CJK. */
@font-face { font-family: 'Playfair Display'; src: url('./assets/fonts/playfair-display-latin-500-normal.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
@font-face { font-family: 'Playfair Display'; src: url('./assets/fonts/playfair-display-latin-600-normal.woff2') format('woff2'); font-weight: 600; font-style: normal; font-display: swap; }
@font-face { font-family: 'Playfair Display'; src: url('./assets/fonts/playfair-display-latin-500-italic.woff2') format('woff2'); font-weight: 500; font-style: italic; font-display: swap; }
.theme-transition,
.theme-transition *,
.theme-transition *::before,
.theme-transition *::after { transition: background-color var(--motion-manager) ease-out,
              color var(--motion-manager) ease-out,
              border-color var(--motion-manager) ease-out,
              box-shadow var(--motion-manager) ease-out !important; }
:focus-visible { outline: 2px solid var(--color-focus-ring);
  outline-offset: 2px; }
.btn-primary { display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 30px;
  padding: 0 14px;
  border: 1px solid var(--color-btn-primary-bg);
  border-radius: var(--radius-pill);
  color: var(--color-btn-primary-fg);
  background: var(--color-btn-primary-bg);
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: var(--tracking-button);
  cursor: pointer;
  transition: background-color var(--motion-manager) ease-out, border-color var(--motion-manager) ease-out; }
.brand-mark { color: var(--color-accent);
  background: var(--color-icon-bg);
  border-radius: var(--radius-pill);
  font-family: var(--font-heading); }
.animate-pop-in { animation: popIn var(--motion-popup) var(--ease-out) forwards; }
/* Same specificity and later than .theme-transition, so it wins the cascade. */
  .theme-transition,
  .theme-transition *,
  .theme-transition *::before,
  .theme-transition *::after { transition: none !important; }
.animate-pop-in { animation: none !important; }
.manager-icon-button { display: inline-flex;
  width: 32px;
  height: 32px;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  color: var(--color-fg-secondary);
  background: transparent;
  cursor: pointer;
  transition: background-color var(--motion-manager) ease-out, color var(--motion-manager) ease-out, border-color var(--motion-manager) ease-out; }
.manager-side-item { display: flex;
  width: 100%;
  min-height: 34px;
  align-items: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: var(--radius-row);
  padding: 0 10px;
  color: var(--color-fg-secondary);
  background: transparent;
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  text-align: left;
  transition: background-color var(--motion-manager) ease-out, color var(--motion-manager) ease-out; }
.manager-side-icon { display: inline-flex;
  width: 18px;
  flex: none;
  align-items: center;
  justify-content: center;
  color: var(--color-fg-secondary);
  transition: color var(--motion-manager) ease-out; }
.manager-search-field:focus-within { outline: 2px solid var(--color-focus-ring);
  outline-offset: 2px; }
.manager-search-field input { width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  color: var(--color-fg);
  background: transparent;
  font-size: 13px; }
.manager-add-button { display: inline-flex;
  width: 34px;
  height: 34px;
  flex: none;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-btn-secondary-border);
  border-radius: var(--radius-pill);
  color: var(--color-accent);
  background: transparent;
  cursor: pointer;
  transition: background-color var(--motion-manager) ease-out; }
.theme-select-trigger { display: flex;
  width: 100%;
  min-height: 30px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border: 0;
  border-radius: var(--radius-pill);
  padding: 5px 12px;
  color: var(--color-fg);
  background: var(--color-field);
  cursor: pointer;
  font-size: 12px;
  font-weight: 500;
  text-align: left;
  transition: background-color var(--motion-manager) ease-out; }
.theme-select-chevron { width: 7px;
  height: 7px;
  flex: none;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg) translateY(-2px);
  transition: transform var(--motion-manager) ease-out; }
.theme-select-option { min-height: 30px;
  display: flex;
  align-items: center;
  border-radius: var(--radius-row);
  padding: 6px 10px;
  color: var(--color-fg-secondary);
  background: transparent;
  cursor: pointer;
  font-size: 12px;
  white-space: nowrap;
  transition: background-color var(--motion-manager) ease-out; }
.manager-snippet-row { position: relative;
  display: flex;
  width: 100%;
  min-height: 56px;
  align-items: center;
  gap: 10px;
  border: 1px solid transparent;
  border-radius: var(--radius-row);
  padding: 8px 10px;
  color: var(--color-fg);
  background: transparent;
  cursor: pointer;
  text-align: left;
  transition: background-color var(--motion-manager) ease-out, border-color var(--motion-manager) ease-out; }
.manager-editor-empty strong { color: var(--color-fg); font-family: var(--font-heading); font-size: 20px; font-weight: 600; }
.manager-editor-title-group h1 { overflow: hidden; margin: 0; color: var(--color-fg); font-family: var(--font-heading); font-size: 22px; font-weight: 600; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.manager-button { display: inline-flex;
  height: 32px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  padding: 0 14px;
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: var(--tracking-button);
  white-space: nowrap;
  transition: background-color var(--motion-manager) ease-out, border-color var(--motion-manager) ease-out, color var(--motion-manager) ease-out; }
/* Filled, borderless controls; focus = 2px offset ring. */
.manager-control { width: 100%;
  min-width: 0;
  border: 0;
  border-radius: var(--radius-pill);
  padding: 8px 14px;
  color: var(--color-fg);
  background: var(--color-field);
  outline: none;
  font-size: 13px; }
.manager-control:focus-visible,
.manager-control:focus { outline: 2px solid var(--color-focus-ring);
  outline-offset: 2px; }
.manager-control.has-error { outline: 2px solid var(--color-danger); outline-offset: 2px; }
.manager-field-error { color: var(--color-danger); font-size: 11px; font-style: normal; font-weight: 600; }
.manager-toggle-row { display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-row);
  padding: 11px 14px;
  background: var(--color-surface);
  cursor: pointer;
  transition: background-color var(--motion-manager) ease-out; }
.manager-switch { appearance: none;
  position: relative;
  width: 36px;
  height: 20px;
  flex: none;
  border: 0;
  border-radius: var(--radius-pill);
  background: var(--color-border-strong);
  cursor: pointer;
  transition: background-color var(--motion-manager) ease-out; }
.manager-switch::after { position: absolute;
  top: 3px;
  left: 3px;
  width: 14px;
  height: 14px;
  border-radius: var(--radius-pill);
  background: var(--color-surface);
  content: '';
  transition: transform var(--motion-manager) ease-out; }
.manager-confirm-dialog h2 { margin: 0; font-family: var(--font-heading); font-size: 18px; font-weight: 600; }
.settings-nav-title { margin: 0;
  color: var(--color-fg);
  font-family: var(--font-heading);
  font-size: 22px;
  font-weight: 600; }
.settings-section-heading h2 { margin: 1px 0 0; color: var(--color-fg); font-family: var(--font-heading); font-size: 18px; font-weight: 600; }
.settings-theme-option { display: flex;
  min-height: 60px;
  align-items: center;
  gap: 10px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-row);
  padding: 10px 14px;
  color: var(--color-fg-secondary);
  background: var(--color-surface);
  cursor: pointer;
  text-align: left;
  transition: background-color var(--motion-manager) ease-out, border-color var(--motion-manager) ease-out; }
.quick-search-field:focus-within { outline: 2px solid var(--color-focus-ring);
  outline-offset: 2px; }
.quick-search-input { height: 100%;
  width: 100%;
  min-width: 0;
  border: 0;
  outline: none;
  color: var(--color-fg);
  background: transparent;
  font-size: 16px; }
.quick-search-item { position: relative;
  z-index: 10;
  display: flex;
  margin: 2px 4px;
  cursor: pointer;
  align-items: center;
  gap: 12px;
  border: 1px solid transparent;
  border-radius: var(--radius-row);
  padding: 8px 12px;
  font-size: 14px;
  outline: none;
  transition: background-color var(--motion-quick) ease-out, border-color var(--motion-quick) ease-out; }
.quick-footer-button { display: inline-flex;
  align-items: center;
  gap: 4px;
  border: 0;
  border-radius: var(--radius-pill);
  padding: 3px 6px;
  color: var(--color-fg-secondary);
  background: transparent;
  cursor: pointer;
  transition: background-color var(--motion-quick) ease-out, color var(--motion-quick) ease-out; }
/* The focus ring is drawn by .quick-search-field:focus-within. */
.quick-search-shell input[cmdk-input]:focus,
.quick-search-shell input[cmdk-input]:focus-visible { border: 0;
  outline: none;
  box-shadow: none; }
.quick-search-window { animation: none !important; }
.manager-code-editor:focus-within { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }
.is-spinning { animation: manager-spin 1s linear infinite; }
.is-spinning { animation: none; }
.manager-drop-overlay strong { font-family: var(--font-heading); font-size: 18px; font-weight: 600; }
