   130	
   131	// SPEC-22：文件模板。日志只记录操作名与错误码，不含文件名、路径或分组名。
   132	#[tauri::command(async)]
   133	pub fn template_import(
   134	    state: tauri::State<'_, AppState>,
   135	    input: TemplateImportInput,
   136	) -> Result<TemplateImportOutcome, AppError> {
   137	    #[cfg(feature = "e2e-webdriver")]
   138	    e2e_import_gate()?;
   139	    audited(&state, "template_import", |s| s.template_import(input))
   140	}
   141	
   142	/// 仅 E2E 构建：`SEARCHIS_E2E_IMPORT_GATE` 指向的文件内容为 `hold` 时，导入在此挂起，
   143	/// 直到内容变为 `release`（放行）或 `fail`（返回注入的错误）。文件不存在则不拦截。
   144	#[cfg(feature = "e2e-webdriver")]
   145	fn e2e_import_gate() -> Result<(), AppError> {
   146	    let Some(gate) = std::env::var_os("SEARCHIS_E2E_IMPORT_GATE") else {
   147	        return Ok(());
   148	    };
   149	    for _ in 0..1500 {
   150	        match std::fs::read_to_string(&gate).as_deref().map(str::trim) {
   151	            Ok("hold") => std::thread::sleep(std::time::Duration::from_millis(20)),
   152	            Ok("fail") => {
   153	                return Err(AppError::new(
   154	                    "E2E_INJECTED_FAILURE",
   155	                    "injected import failure",
   156	                ))
   157	            }
   158	            _ => return Ok(()),
   159	        }
   160	    }
   161	    Ok(())
   162	}
